mncs 0.18;

// mncs.fem.shape1d.v1 — linear 1D shape functions on the reference element.
//
// Reference coordinate xi in [-1, 1]; node 0 at xi = -1, node 1 at xi = +1.
// The formulation is exact closed-form algebra (no quadrature needed for
// the linear bar: stiffness integrates exactly), so every property below
// is an exact binary64 identity on the stated inputs, asserted with `==`.

module mncs.fem.shape1d.v1;

// N0(xi) = (1 - xi) / 2.
fn shape_n0(xi: f64) -> (result: f64) {
    return 0.5 * (1.0 - xi);
}

// N1(xi) = (1 + xi) / 2.
fn shape_n1(xi: f64) -> (result: f64) {
    return 0.5 * (1.0 + xi);
}

// Constant derivatives: dN0/dxi = -1/2, dN1/dxi = +1/2.
fn shape_dn0() -> (result: f64) {
    return -0.5;
}

fn shape_dn1() -> (result: f64) {
    return 0.5;
}

// Reference-domain membership: the interpolation contract holds on [-1, 1].
fn in_reference(xi: f64) -> (result: bool) {
    return xi >= -1.0 && xi <= 1.0;
}

// Interpolated field value at xi from nodal values u0, u1.
fn shape_interp(xi: f64, u0: f64, u1: f64) -> (result: f64) {
    return shape_n0(xi) * u0 + shape_n1(xi) * u1;
}

// Partition of unity residual: N0(xi) + N1(xi) - 1. Zero when conforming.
fn partition_residual(xi: f64) -> (result: f64) {
    return shape_n0(xi) + shape_n1(xi) - 1.0;
}
