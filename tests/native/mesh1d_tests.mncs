mncs 0.18;

// Native contracts for mesh topology: identity, validation, builders.
// Exact `==` throughout: all coordinates are dyadic, so every length
// and builder value is an exact binary64 identity.

module mncs.fem.test.mesh1d.v1;

use mncs.test.assertions;
use mncs.test.suite;
use mncs.fem.mesh1d;

test node_identity_not_coordinate_equality() -> (result: TestResult) {
    // Two DISTINCT nodes may share one coordinate; connectivity over
    // them is still valid. Identity is the id, never the position.
    let a: Node1 = node1(0, 1.0);
    let b: Node1 = node1(1, 1.0);
    let same_spot: bool = a.x == b.x;
    let distinct: bool = a.id != b.id;
    let e: BarElement = bar_element(0, a.id, b.id);
    let ok: bool = elem_is_ok(check_element(e, 2));
    return from_assertion(equals_bool(true, same_spot && distinct && ok, 4101));
}

test connectivity_references_existing_nodes() -> (result: TestResult) {
    let good: bool = elem_is_ok(check_element(bar_element(0, 0, 1), 2));
    let missing_hi: bool = match check_element(bar_element(1, 0, 2), 2) {
        ElemCheck.Ok => false,
        ElemCheck.NodeOutOfRange => true,
        ElemCheck.SelfConnected => false,
    };
    let missing_lo: bool = match check_element(bar_element(2, 7, 1), 2) {
        ElemCheck.Ok => false,
        ElemCheck.NodeOutOfRange => true,
        ElemCheck.SelfConnected => false,
    };
    return from_assertion(equals_bool(true, good && missing_hi && missing_lo, 4102));
}

test self_connected_element_rejected() -> (result: TestResult) {
    let dup: bool = match check_element(bar_element(0, 1, 1), 3) {
        ElemCheck.Ok => false,
        ElemCheck.NodeOutOfRange => false,
        ElemCheck.SelfConnected => true,
    };
    // A degenerate duplicate is SelfConnected even in a 1-node mesh,
    // not silently out-of-range: the checks compose in range order.
    let dup_small: bool = match check_element(bar_element(0, 0, 0), 1) {
        ElemCheck.Ok => false,
        ElemCheck.NodeOutOfRange => false,
        ElemCheck.SelfConnected => true,
    };
    return from_assertion(equals_bool(true, dup && dup_small, 4103));
}

test whole_mesh_validation() -> (result: TestResult) {
    let elems: [BarElement; 2] = [bar_element(0, 0, 1), bar_element(1, 1, 2)];
    let ok: bool = mesh_ok(elems, 3);
    let bad: [BarElement; 2] = [bar_element(0, 0, 1), bar_element(1, 1, 5)];
    let not_ok: bool = mesh_ok(bad, 3) == false;
    return from_assertion(equals_bool(true, ok && not_ok, 4104));
}

test element_length_values() -> (result: TestResult) {
    let fwd: bool = elem_length(1.0, 3.0) == 2.0;
    let rev: bool = elem_length(3.0, 1.0) == 2.0;
    let zero: bool = elem_length(2.0, 2.0) == 0.0;
    return from_assertion(equals_bool(true, fwd && rev && zero, 4105));
}

test length_translation_invariant() -> (result: TestResult) {
    let a: bool = elem_length(1.0 + 5.0, 3.0 + 5.0) == elem_length(1.0, 3.0);
    let b: bool = elem_length(0.0 - 4.0, 2.0 - 4.0) == elem_length(0.0, 2.0);
    return from_assertion(equals_bool(true, a && b, 4106));
}

test uniform_builder_values() -> (result: TestResult) {
    let x0: bool = match uniform_node_x(0.0, 2.0, 0, 3) {
        NodeX.Value { x } => x == 0.0,
        NodeX.BadIndex => false,
    };
    let x1: bool = match uniform_node_x(0.0, 2.0, 1, 3) {
        NodeX.Value { x } => x == 1.0,
        NodeX.BadIndex => false,
    };
    let x2: bool = match uniform_node_x(0.0, 2.0, 2, 3) {
        NodeX.Value { x } => x == 2.0,
        NodeX.BadIndex => false,
    };
    return from_assertion(equals_bool(true, x0 && x1 && x2, 4107));
}

test uniform_builder_rejects_degenerate() -> (result: TestResult) {
    let single: bool = match uniform_node_x(0.0, 1.0, 0, 1) {
        NodeX.Value { x } => x != x,
        NodeX.BadIndex => true,
    };
    let past_end: bool = match uniform_node_x(0.0, 1.0, 2, 2) {
        NodeX.Value { x } => x != x,
        NodeX.BadIndex => true,
    };
    return from_assertion(equals_bool(true, single && past_end, 4108));
}
